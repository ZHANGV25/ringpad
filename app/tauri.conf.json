{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringpad",
  "version": "0.1.1",
  "identifier": "io.github.zhangv25.ringpad",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ringpad",
        "width": 380,
        "height": 680,
        "minWidth": 340,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../third_party/vb-cable/*": "vbcable/"
    },
    "shortDescription": "Soundboard with instant replay for voice chat",
    "publisher": "Ringpad contributors",
    "copyright": "MIT License",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
