{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringpad",
  "version": "0.1.0",
  "identifier": "io.github.zhangv25.ringpad",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ringpad",
        "width": 380,
        "height": 680,
        "minWidth": 340,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
